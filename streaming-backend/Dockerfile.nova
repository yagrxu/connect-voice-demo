# Nova Sonic service image (aws-sdk-bedrock-runtime / awscrt~=0.32).
FROM public.ecr.aws/docker/library/python:3.12-slim
WORKDIR /app
COPY requirements-nova.txt .
RUN pip install --no-cache-dir -r requirements-nova.txt
COPY . .
EXPOSE 8000
CMD ["uvicorn", "nova_app:app", "--host", "0.0.0.0", "--port", "8000"]
